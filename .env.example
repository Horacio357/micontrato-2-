# Configuración del Puerto del Servidor (Railway asigna automáticamente el PORT)
PORT=3000

# Cadena de conexión a la Base de Datos PostgreSQL de Railway
DATABASE_URL="postgresql://postgres:password@localhost:5432/micontrato?schema=public"

# Clave secreta para generación de tokens JWT de autenticación
JWT_SECRET="micontratos-super-secret-key-production-2026-secure"

# Dominio público oficial de la web
FRONTEND_URL="https://micontratos.com"

# Entorno de ejecución (en producción usar "production")
NODE_ENV="production"

# Habilitar pagos simulados (QA): en producción con Stripe real DEBE ser "false"
ENABLE_QA_PAYMENTS="false"
VITE_ENABLE_QA_PAYMENTS="false"

# Lista de emails de Super Administradores con acceso al panel /admin (separados por coma)
SUPER_ADMIN_EMAILS="heraclescasares@gmail.com"

# Bootstrap seguro del primer Administrador en producción
ADMIN_EMAIL="heraclescasares@gmail.com"
ADMIN_INITIAL_PASSWORD=""

# Claves de Stripe para cobros reales y verificación criptográfica de webhooks
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# (Opcional) Clave de API de Resend para envío de emails transaccionales
RESEND_API_KEY=""

# Clave de API de Google Gemini para el asistente virtual (chatbot)
GEMINI_API_KEY=""
# (Opcional) Modelo Gemini a utilizar (por defecto: gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"

# (Opcional / Respaldo) Clave de API de Groq si no se usa Gemini
GROQ_API_KEY=""
