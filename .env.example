# Configuración del Puerto del Servidor (Railway asigna automáticamente el PORT)
PORT=3000

# Cadena de conexión a la Base de Datos PostgreSQL de Railway
DATABASE_URL="postgresql://postgres:password@localhost:5432/micontrato?schema=public"

# Clave secreta para generación de tokens JWT de autenticación
JWT_SECRET="micontratos-super-secret-key-production-2026-secure"

# Dominio público oficial de la web
FRONTEND_URL="https://micontratos.com"

# Habilitar pagos simulados (QA) para testear contratos sin tarjeta real (true/false)
ENABLE_QA_PAYMENTS="true"
VITE_ENABLE_QA_PAYMENTS="true"

# Lista de emails de Super Administradores con acceso al panel /admin (separados por coma)
SUPER_ADMIN_EMAILS="admin@micontratos.com,heraclescasares@gmail.com"

# (Opcional) Clave secreta de Stripe cuando se conecte la cuenta comercial
STRIPE_SECRET_KEY=""

# (Opcional) Clave de API de Resend para envío de emails transaccionales
RESEND_API_KEY=""

# (Opcional) Clave de API de Groq para el asistente virtual con IA (Llama 3.3 70B)
GROQ_API_KEY="gsk_..."
