# Configuración del Puerto del Servidor (Railway asigna automáticamente el PORT)
PORT=3000

# Cadena de conexión a la Base de Datos PostgreSQL de Railway
DATABASE_URL="postgresql://postgres:password@localhost:5432/micontrato?schema=public"

# Clave secreta para generación de tokens JWT de autenticación
JWT_SECRET="micontrato-super-secret-key-railway-2026"

# (Opcional) Clave secreta de Stripe si se activan cobros reales
STRIPE_SECRET_KEY=""

# (Opcional) Clave de API de Resend o SMTP para envío de emails
RESEND_API_KEY=""

# Clave de API de Groq para el asistente virtual con IA (Llama 3.3 70B)
GROQ_API_KEY="gsk_..."
